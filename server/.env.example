# ── ShortsInShort API configuration ─────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB (local install or Atlas). Use a replica set in production (Atlas is one).
MONGODB_URI=mongodb://127.0.0.1:27017/shortsinshort_dev

# Public URL of the web app. In dev the Vite server proxies /api to this API.
APP_URL=http://localhost:5173
# Extra allowed CORS origins, comma-separated (optional)
CORS_ORIGINS=
# Production single-origin hosting: path of the built web app (client/dist) to serve from the API.
# The Docker image sets this to /app/client/dist. Leave empty in development (Vite serves the app).
# CLIENT_DIST_DIR=
# Extra origins the web app may load media from / upload to (e.g. an R2 custom domain), comma-separated
MEDIA_ORIGINS=
# Number of reverse proxies in front of the API (1 behind nginx / a load balancer)
TRUST_PROXY=0

# REQUIRED: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=false

REQUIRE_EMAIL_VERIFICATION=true
FREE_PLAN_CREDITS=3

# ── Email (REQUIRED in production) ──
# Any SMTP provider works: Resend, Brevo, Amazon SES, Postmark, Mailgun…
# If SMTP_HOST is empty in development, emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShortsInShort <no-reply@yourdomain.com>"

# ── Google sign-in (optional) ──
# Create an OAuth 2.0 Client (Web) at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:5173/api/auth/google/callback (dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   (defaults to APP_URL + /api/auth/google/callback)

# ── Media storage ──
# local = files on this server's disk, served via short-lived HMAC-signed URLs (dev / single server)
# s3    = Cloudflare R2 or AWS S3 (private bucket, presigned URLs) — required for multi-server production
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Optional; derived from JWT_ACCESS_SECRET when empty
# STORAGE_SIGNING_SECRET=
# R2 example: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Uploads ──
MAX_UPLOAD_MB=500
MAX_SOURCE_DURATION_SEC=900

# ── Video processing ──
# Bundled FFmpeg/FFprobe binaries are used by default; set these to use system builds (recommended in production).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# embedded = API process also runs the render worker (default in development)
# off      = run `npm run worker` as a separate process (default in production)
# WORKER_MODE=embedded
WORKER_CONCURRENCY=1
JOB_TIMEOUT_MIN=30

# ── AI providers ──
# Speech-to-text for captions + filler-word removal. Get a key at https://console.deepgram.com
# Without it, renders work but captions are skipped (the app says so).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Fonts for burned-in captions (defaults: C:/Windows/Fonts on Windows, /usr/share/fonts on Linux).
# Production images should install fonts-noto (Latin + Devanagari/Telugu/Tamil).
# CAPTION_FONTS_DIR=
# AI analysis: caption keywords, caption translation, B-roll planning. Key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Thinking level for our structured AI tasks ('' = model default). low keeps scene planning fast.
# GEMINI_THINKING_LEVEL=low
# Licensed stock footage for B-roll (Pixabay Content License). Key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# AI voiceovers (text-to-speech). Sarvam AI is the default — Indian-language voices, voice cloning (beta).
# Key: https://dashboard.sarvam.ai (₹100 free credit). TTS_PROVIDER=auto uses Sarvam when its key is set.
SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v3
# TTS_PROVIDER=auto              # auto | sarvam | elevenlabs
# Optional alternative voice provider. Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2      # English, Hindi, Tamil
# ELEVENLABS_MODEL_INDIC=eleven_v3             # Telugu, Marathi
# Talking-avatar presenters (HeyGen API v3). Key: HeyGen app → Settings → API
HEYGEN_API_KEY=
# Licensed background music: a folder with your tracks + music.json manifest (see server/src/services/ai/music.ts).
# Only tracks that exist and declare a license are used. Leave empty to render without music.
# MUSIC_LIBRARY_DIR=C:/ShortsInShort/music

# Motion Explainer (Remotion). Defaults bundle client/src/motion on first render; Chrome Headless Shell
# is downloaded by Remotion on first use. Remotion needs a Company License for teams of more than 3 people.
# MOTION_BUNDLE_DIR=        # prebuilt bundle (faster first render)
# MOTION_CONCURRENCY=2      # browser tabs per render

# Payments (Razorpay). Start with TEST keys (Dashboard → Settings → API Keys); enable auto-capture.
# Webhook URL (must be public HTTPS): https://<your-domain>/api/billing/webhook
# Events: payment.captured, payment.failed, order.paid, subscription.* (all)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST invoices (seller details). Confirm the SAC code with your CA.
# BILLING_LEGAL_NAME=Your Company Pvt Ltd
# BILLING_GSTIN=
# BILLING_ADDRESS=Street, City, PIN
# BILLING_STATE_CODE=36           # GST state code (36 Telangana, 37 Andhra Pradesh, 29 Karnataka…)
# BILLING_SAC=998314
# BILLING_INVOICE_PREFIX=SIS
# PRICES_INCLUDE_GST=true          # plan/pack prices include 18% GST
# GST_RATE_PERCENT=18

