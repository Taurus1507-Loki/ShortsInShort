{
  "name": "@shortsinshort/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx src/scripts/createAdmin.ts",
    "email:test": "tsx src/scripts/testEmail.ts",
    "admin:plan": "tsx src/scripts/setPlan.ts",
    "metrics:render": "tsx src/scripts/renderMetrics.ts",
    "motion:prepare": "tsx src/scripts/prepareMotion.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@remotion/bundler": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.3.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "nodemailer": "^10.4.0",
    "pdfkit": "0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.542",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
