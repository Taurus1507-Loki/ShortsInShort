# ── ShortsInShort production configuration ──────────────────────────────────
# Copy to deploy/.env.production (never commit it) and fill in. Every secret must be freshly
# generated for production — never reuse development values or legacy/server/.env.example.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=production
LOG_LEVEL=info
APP_URL=https://app.example.com

# Bundled single-node replica set (docker-compose.prod.yml) — or your Atlas connection string.
MONGODB_URI=mongodb://mongo:27017/shortsinshort?replicaSet=rs0

JWT_ACCESS_SECRET=
STORAGE_SIGNING_SECRET=

# Email (required in production): Resend / Brevo / Amazon SES on your own domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShortsInShort <no-reply@example.com>"

# Google sign-in — add https://app.example.com/api/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Media: Cloudflare R2 (recommended). With STORAGE_DRIVER=local media lives on the server's disk.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

WORKER_CONCURRENCY=1

# AI providers
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
PIXABAY_API_KEY=
SARVAM_API_KEY=
HEYGEN_API_KEY=

# Razorpay (test keys until the test run passes). Webhook: https://app.example.com/api/billing/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
